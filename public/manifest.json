{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "theHunterWiki",
    "version": "1.0.2",
    "minimum-overwolf-version": "0.198.0",
    "author": "Manny",
    "description": "Overwolf extension for theHunter: COTW. Keep a complete wiki always at hand directly in-game.",
    "dock_button_title": "theHunterWiki",
    "icon": "icons/IconMouseOver.png",
    "icon_gray": "icons/IconMouseNormal.png",
    "launcher_icon": "icons/launcher_icon.ico"
  },
  "permissions": ["GameInfo", "FileSystem", "Hotkeys"],
  "data": {
    "start_window": "background",
    "hotkeys": {
      "show_hide_wiki": {
        "title": "Show/Hide theHunterWiki",
        "action-type": "custom",
        "default": "Ctrl+B"
      }
    },
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true,
        "visible": false
      },
      "desktop": {
        "file": "desktop.html",
        "desktop_only": true,
        "native_window": true,
        "size": { "width": 1200, "height": 800 },
        "min_size": { "width": 1140, "height": 660 },
        "resizable": true,
        "show_in_taskbar": true,
        "grab_keyboard_focus": true
      },
      "in_game": {
        "file": "in_game.html",
        "in_game_only": true,
        "resizable": true,
        "transparent": true,
        "size": { "width": 1200, "height": 760 },
        "min_size": { "width": 1140, "height": 660 },
        "keep_window_open": true,
        "focus_game_takeover": "ReleaseOnHidden",
        "grab_keyboard_focus": true,
        "grab_focus_on_show": true
      }
    },
    "uninstall_window": {
      "file": "uninstall.html",
      "required_runtime": 3000
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [23010]
    },
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [23010] },
        "start_minimized": true
      }
    ]
  }
}
